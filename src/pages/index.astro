---
import Base from '../layouts/Base.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url); const t = useTranslations(lang);
---
<Base title="Engeletron — Circuitos integrados de RF" description={t('home.hero.tag')}>
  <main class="wrap" style="padding:60px 5vw">
    <div class="eb">{t('home.hero.eyebrow')}</div>
    <h1 style="font-size:48px;margin:12px 0">{t('home.hero.title.a')}<span class="cyan">{t('home.hero.title.em')}</span>{t('home.hero.title.b')}</h1>
    <p style="color:var(--dim);max-width:50ch">{t('home.hero.tag')}</p>
  </main>
</Base>
