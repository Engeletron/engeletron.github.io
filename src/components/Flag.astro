---
// Bandeira inline como imagem (emoji de bandeira não renderiza no Windows).
const { code, alt = '' } = Astro.props;
---
<img class="flag-img" src={`/assets/flags/${code}.png`} alt={alt} loading="lazy" />
<style>
  .flag-img{
    display:inline-block;width:1.35em;height:auto;
    vertical-align:-0.2em;border-radius:2px;margin:0 .12em;
    box-shadow:0 0 0 1px rgba(255,255,255,.15);
  }
</style>
