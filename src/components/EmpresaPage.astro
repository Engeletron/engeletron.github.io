---
import Base from '../layouts/Base.astro';
import SiliconSection from './SiliconSection.astro';
import { companies } from '../data/company';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url); const t = useTranslations(lang);
const team = [
  {name:'Danilo Miguel Neves Adur', roleKey:'team.role.dir.m', crea:'CREA‑PR PR‑87205/D', email:'danilo@engeletron.com.br', phone:'(41) 99904‑2212', photo:'/assets/danilo.jpg'},
  {name:'Gisely Bellozupko Adur', roleKey:'team.role.dir.f', crea:'CREA‑PR PR‑87210/D', email:'gisely@engeletron.com.br', phone:'(41) 99904‑2302', photo:'/assets/gisely.jpg'},
];
---
<Base title={t('meta.title.company')} description={t('meta.desc.company')}>
  <div class="wrap">
    <section style="border-top:none">
      <div class="stitle">{t('home.company.eyebrow')}</div>
      <div class="sh">{t('home.company.title')}</div>
      <p style="color:var(--dim);max-width:64ch">{t('company.about')}</p>
    </section>
  </div>
  <div class="wrap"><SiliconSection /></div>
  <div class="wrap">
    <section>
      <div class="stitle">{t('company.team.eyebrow')}</div>
      <div class="sh">{t('company.team.title')}</div>
      <div class="team">
        {team.map(m => (
          <div class="member">
            <img src={m.photo} alt={m.name} />
            <h3>{m.name}</h3>
            <p class="role">{t(m.roleKey as any)}</p>
            <p class="meta">{m.crea}</p>
            <p class="meta"><a class="cyan" href={`mailto:${m.email}`}>{m.email}</a></p>
            <p class="meta">{m.phone}</p>
          </div>
        ))}
      </div>
    </section>
    <section>
      <div class="stitle">{t('company.legal.eyebrow')}</div>
      <div class="sh">{t('company.legal.title')}</div>
      <div class="cbox">
        <p class="rl">{t('company.role.dev')}</p>
        <p><b>{companies.developer.name}</b> · CNPJ {companies.developer.cnpj}</p>
        <p class="rl">{t('company.role.seller')}</p>
        <p><b>{companies.seller.name}</b> · CNPJ {companies.seller.cnpj}</p>
      </div>
    </section>
  </div>
  <style>
    .team{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:10px}
    .member{border:1px solid var(--line);border-radius:14px;padding:22px;background:var(--panel);text-align:center}
    .member img{width:96px;height:96px;border-radius:50%;object-fit:cover;border:1px solid var(--line)}
    .member h3{font-size:21px;margin:12px 0 4px}.member .role{color:var(--cyan);font-size:17px}.member .meta{color:var(--dim);font-size:17px}
    .cbox{border:1px solid var(--line);border-radius:14px;padding:22px;background:var(--panel);line-height:1.9}
    .cbox .rl{color:var(--cyan);font-weight:600;font-size:14px;letter-spacing:.04em;margin-top:14px}
    .cbox .rl:first-child{margin-top:0}
    @media(max-width:760px){.team{grid-template-columns:1fr}}
  </style>
</Base>
