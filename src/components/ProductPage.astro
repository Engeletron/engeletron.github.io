---
import Base from '../layouts/Base.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import { eetx433a } from '../data/product';
import ChipViewer from './ChipViewer.astro';
import SpecTable from './SpecTable.astro';
import AdvantagesCompare from './AdvantagesCompare.astro';
import AppCards from './AppCards.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<Base title={t('meta.title.product')} description={t('product.hero.tag')}>

  <!-- PRODUCT HERO -->
  <div class="wrap">
    <div class="hero">
      <div>
        <div class="bc">
          {t('product.hero.bc').split('/').map((seg, i, arr) => (
            i < arr.length - 1
              ? <span>{seg.trim()} /&nbsp;</span>
              : <span class="cyan">{seg.trim()}</span>
          ))}
        </div>
        <div class="eb">{t('product.hero.eyebrow')}</div>
        <h1>EETX433A</h1>
        <p class="tag">{t('product.hero.tag')}</p>
        <div class="chips">
          <span class="chip"><b>433.92</b> MHz</span>
          <span class="chip"><b>+13 <span style="color:#fff">dBm</span></b> {t('product.chip.adj')}</span>
          <span class="chip"><b>1–6</b> {t('product.card.keys')}</span>
          <span class="chip">{t('product.chip.fixedcode')}</span>
          <span class="chip"><b>1.000.000</b> {t('product.card.comb')}</span>
          <span class="chip"><b>SOIC‑8</b> SMD</span>
        </div>
        <div class="cta-row">
          <a href={eetx433a.whatsapp} target="_blank" rel="noopener" class="btn fill">{t('cta.sample')}</a>
          <a href="#" class="btn ghost" aria-disabled="true">{t('product.hero.datasheet')}</a>
          <a href={eetx433a.whatsapp} target="_blank" rel="noopener" class="btn ghost">{t('cta.whatsapp')}</a>
        </div>
      </div>
      <ChipViewer height="440px" />
    </div>
  </div>

  <!-- ESPECIFICAÇÕES -->
  <section>
    <div class="wrap">
      <div class="stitle">{t('product.spec.eyebrow')}</div>
      <div class="sh">{t('product.spec.title')}</div>
      <SpecTable />
    </div>
  </section>

  <!-- INTEGRAÇÃO RADICAL -->
  <section>
    <div class="wrap">
      <div class="stitle">{t('product.adv.eyebrow')}</div>
      <div class="sh">{t('product.adv.title')}</div>
      <AdvantagesCompare />
    </div>
  </section>

  <!-- APLICAÇÕES -->
  <section>
    <div class="wrap">
      <div class="stitle">{t('product.apps.eyebrow')}</div>
      <div class="sh">{t('product.apps.title')}</div>
      <AppCards />
    </div>
  </section>

  <!-- DOCUMENTAÇÃO / DOWNLOADS -->
  <section>
    <div class="wrap">
      <div class="stitle">{t('product.docs.eyebrow')}</div>
      <div class="sh">{t('product.docs.title')}</div>
      <div class="dl">
        <div class="dlc">
          <span class="big">📄</span>
          <div>
            <b>{t('product.docs.ds.label')}</b>
            <small>{t('product.docs.ds.sub')}</small>
          </div>
          <span class="soon">{t('product.docs.soon')}</span>
        </div>
        <div class="dlc">
          <span class="big">📘</span>
          <div>
            <b>{t('product.docs.an.label')}</b>
            <small>{t('product.docs.an.sub')}</small>
          </div>
          <span class="soon">{t('product.docs.soon')}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- COMERCIAL -->
  <section>
    <div class="wrap">
      <div class="stitle">{t('product.commercial.eyebrow')}</div>
      <div class="sh">{t('product.commercial.title')}</div>
      <div class="commercial">
        <div class="cbox">
          <div class="num">4.000 <span class="unit">{t('product.commercial.moq.unit')}</span></div>
          <p class="moq-body">{t('product.commercial.moq.body')}</p>
        </div>
        <div class="cbox cta-box">
          <h3 class="cbox-title">{t('product.commercial.sample.title')}</h3>
          <p class="cbox-body">{t('product.commercial.sample.body')}</p>
          <div class="cta-row">
            <a href={eetx433a.whatsapp} target="_blank" rel="noopener" class="btn fill">{t('cta.sample')}</a>
            <a href={eetx433a.whatsapp} target="_blank" rel="noopener" class="btn ghost">{t('product.commercial.whatsapp')}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Base>

<style>
  /* HERO */
  .hero {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 30px;
    align-items: center;
    padding: 46px 0 30px;
  }
  @media (max-width: 900px) { .hero { grid-template-columns: 1fr; } }

  .bc { color: var(--dim); font-size: 15px; letter-spacing: 0.06em; margin-bottom: 14px; }
  .bc .cyan { color: var(--cyan); }

  .hero h1 {
    font-size: clamp(40px, 7vw, 76px);
    line-height: 0.98;
    letter-spacing: -0.01em;
    margin: 10px 0 6px;
  }
  .hero .tag { color: var(--dim); font-size: 20px; max-width: 48ch; }

  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 22px 0; }

  .cta-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }

  /* DOWNLOADS */
  .dl { display: flex; flex-wrap: wrap; gap: 12px; }
  .dlc {
    flex: 1;
    min-width: 220px;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 16px;
    background: var(--panel);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .dlc .big { font-size: 22px; }
  .dlc small { color: var(--dim); display: block; font-size: 16px; }
  .soon {
    margin-left: auto;
    font-size: 13px;
    border: 1px solid var(--line);
    padding: 3px 7px;
    border-radius: 6px;
    color: var(--dim);
    white-space: nowrap;
  }

  /* COMMERCIAL */
  .commercial { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  @media (max-width: 760px) { .commercial { grid-template-columns: 1fr; } }

  .cbox {
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 22px;
    background: linear-gradient(180deg, var(--panel), var(--bg2));
  }
  .cbox.cta-box { border-color: rgba(92,225,230,.4); }

  .num {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 34px;
    color: #fff;
  }
  .num .unit { font-size: 18px; color: var(--dim); }

  .moq-body { color: var(--dim); margin-top: 6px; font-size: 17px; }

  .cbox-title { font-size: 21px; margin-bottom: 8px; }
  .cbox-body { color: var(--dim); margin-bottom: 14px; font-size: 17px; }
</style>
