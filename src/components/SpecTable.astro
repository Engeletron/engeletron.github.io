---
import { eetx433a } from '../data/product';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const rows: [Parameters<typeof t>[0], string][] = [
  ['spec.freq',       eetx433a.freq],
  ['spec.power',      eetx433a.power],
  ['spec.keys',       eetx433a.keys],
  ['spec.encoding',   eetx433a.encoding],
  ['spec.txTime',     eetx433a.txTime],
  ['spec.oscillator', eetx433a.oscillator],
  ['spec.protocol',   eetx433a.protocol],
  ['spec.programming',eetx433a.programming],
  ['spec.package',    eetx433a.package],
  ['spec.supply',     eetx433a.supply],
];
---
<div class="specs">
  {rows.map(([k, v]) => (
    <div class="spec"><span>{t(k)}</span><b>{v}</b></div>
  ))}
</div>
<style>
  .specs{display:grid;grid-template-columns:1fr 1fr;gap:14px 40px}
  .spec{display:flex;justify-content:space-between;gap:16px;padding:11px 0;border-bottom:1px solid #16223a;font-size:14.5px}
  .spec span{color:var(--dim)} .spec b{color:#eaf0fb;font-weight:500;font-family:'Space Grotesk'}
  @media(max-width:760px){.specs{grid-template-columns:1fr}}
</style>
