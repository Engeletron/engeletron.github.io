---
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import LangSwitcher from './LangSwitcher.astro';
const lang = getLangFromUrl(Astro.url); const t = useTranslations(lang);
const base = lang === 'pt' ? '' : `/${lang}`;
---
<nav>
  <a class="logo" href={base + '/'}>
    <img class="m" src="/assets/icon_engeletron.svg" alt="Engeletron" width="30" height="30" /><b>ENGELETRON</b><span class="tag">SEMICONDUCTOR</span>
  </a>
  <div class="links">
    <a href={base + '/produtos/eetx433a'}>{t('nav.products')}</a>
    <a href={base + '/servicos'}>{t('nav.services')}</a>
    <a href={base + '/tecnologia'}>{t('nav.tech')}</a>
    <a href={base + '/aplicacoes'}>{t('nav.apps')}</a>
    <a href={base + '/empresa'}>{t('nav.company')}</a>
    <a href={base + '/contato'}>{t('nav.contact')}</a>
  </div>
  <div class="right">
    <LangSwitcher />
  </div>
</nav>
<style>
  nav{position:sticky;top:0;z-index:50;display:flex;align-items:center;gap:16px;padding:14px 5vw;background:rgba(7,11,22,.82);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
  .logo{display:flex;align-items:center;gap:10px;flex:none}
  .logo .m{width:48px;height:48px;display:block;filter:drop-shadow(0 0 13px rgba(92,225,230,.5))}
  .logo b{font-family:'Space Grotesk';letter-spacing:.18em;font-size:19px}
  .logo .tag{color:var(--cyan);font-size:12px;letter-spacing:.34em;border-left:1px solid var(--line);padding-left:9px}
  .links{display:flex;gap:16px;margin-left:14px;font-size:17px;color:var(--dim)}
  .links a:hover{color:var(--txt)}
  .right{margin-left:auto;display:flex;align-items:center;gap:14px}
  @media(max-width:760px){
    nav{flex-wrap:wrap;gap:12px 16px;padding:12px 16px}
    .logo .tag{display:none}
    .right{order:2;width:100%;margin-left:0;justify-content:center}
    .links{order:3;width:100%;margin-left:0;justify-content:center;flex-wrap:wrap;gap:12px 16px;font-size:16px}
  }
</style>
