---
import Base from '../layouts/Base.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import { eetx433a } from '../data/product';
import ChipViewer from './ChipViewer.astro';
import ProductCard from './ProductCard.astro';
import SiliconSection from './SiliconSection.astro';
import AppCards from './AppCards.astro';
import ContactCTA from './ContactCTA.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = lang === 'pt' ? '' : `/${lang}`;
---
<Base title="Engeletron — Circuitos integrados de RF" description={t('home.hero.tag')}>

  <!-- HERO -->
  <div class="wrap">
    <div class="hero">
      <div>
        <div class="eb">{t('home.hero.eyebrow')}</div>
        <h1>{t('home.hero.title.a')}<em>{t('home.hero.title.em')}</em>{t('home.hero.title.b')}</h1>
        <p class="tag">{t('home.hero.tag')}</p>
        <div class="cta-row">
          <a href={`${base}/produtos/eetx433a`} class="btn fill">{t('cta.knowProduct')}</a>
          <a href={eetx433a.whatsapp} target="_blank" rel="noopener" class="btn ghost">{t('cta.sample')}</a>
        </div>
      </div>
      <ChipViewer height="460px" />
    </div>
  </div>

  <!-- NOSSO PRODUTO -->
  <section>
    <div class="wrap">
      <div class="stitle">{t('home.product.eyebrow')}</div>
      <div class="sh">{t('home.product.title')}</div>
      <div class="ssub">{t('home.product.sub')}</div>
      <ProductCard />
    </div>
  </section>

  <!-- TECNOLOGIA -->
  <section>
    <div class="wrap">
      <div class="stitle">{t('home.tech.eyebrow')}</div>
      <div class="sh">{t('home.tech.title')}</div>
      <div class="grid3">
        <div class="card">
          <div class="ic">◷</div>
          <h3>{t('home.tech.osc.title')}</h3>
          <p>{t('home.tech.osc.body')}</p>
        </div>
        <div class="card">
          <div class="ic">⌗</div>
          <h3>{t('home.tech.diodes.title')}</h3>
          <p>{t('home.tech.diodes.body')}</p>
        </div>
        <div class="card">
          <div class="ic">⚡</div>
          <h3>{t('home.tech.ready.title')}</h3>
          <p>{t('home.tech.ready.body')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SILICON -->
  <section>
    <div class="wrap">
      <SiliconSection />
    </div>
  </section>

  <!-- APLICAÇÕES -->
  <section>
    <div class="wrap">
      <div class="stitle">{t('home.apps.eyebrow')}</div>
      <div class="sh">{t('home.apps.title')}</div>
      <AppCards />
    </div>
  </section>

  <!-- A ENGELETRON -->
  <section>
    <div class="wrap">
      <div class="stitle">{t('home.company.eyebrow')}</div>
      <div class="sh">{t('home.company.title')}</div>
      <div class="ssub">{t('home.company.sub')}</div>
      <div class="stats">
        <div class="stat"><div class="n">{t('home.stat1.n')}</div><small>{t('home.stat1.label')}</small></div>
        <div class="stat"><div class="n">{t('home.stat2.n')}</div><small>{t('home.stat2.label')}</small></div>
        <div class="stat"><div class="n">{t('home.stat3.n')}</div><small>{t('home.stat3.label')}</small></div>
        <div class="stat"><div class="n">{t('home.stat4.n')}</div><small>{t('home.stat4.label')}</small></div>
      </div>
    </div>
  </section>

  <!-- CONTACT CTA -->
  <section>
    <div class="wrap">
      <ContactCTA />
    </div>
  </section>

</Base>

<style>
  /* HERO */
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 30px;
    align-items: center;
    padding: 60px 0 40px;
  }
  @media (max-width: 900px) { .hero { grid-template-columns: 1fr; } }

  .hero h1 {
    font-size: clamp(40px, 6.4vw, 72px);
    line-height: 1.0;
    letter-spacing: -0.015em;
    margin: 14px 0 8px;
  }
  .hero h1 em {
    font-style: normal;
    background: linear-gradient(120deg, var(--cyan), var(--blue));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero .tag {
    color: var(--dim);
    font-size: 18px;
    max-width: 50ch;
    margin-bottom: 24px;
  }
  .cta-row { display: flex; flex-wrap: wrap; gap: 10px; }

  /* TECH CARDS */
  .grid3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  @media (max-width: 760px) { .grid3 { grid-template-columns: 1fr; } }
  .card {
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 22px;
    background: var(--panel);
  }
  .card .ic { color: var(--cyan); font-size: 22px; }
  .card h3 { font-size: 17px; margin: 10px 0 6px; }
  .card p { color: var(--dim); font-size: 13.5px; }

  /* STATS */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 10px;
  }
  @media (max-width: 760px) { .stats { grid-template-columns: 1fr 1fr; } }
  .stat {
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 20px;
    background: var(--panel);
    text-align: center;
  }
  .stat .n { font-family: 'Space Grotesk', sans-serif; font-size: 30px; color: #fff; }
  .stat small { color: var(--dim); }

  /* SECTION OVERRIDE: SiliconSection has its own section tag — avoid double border */
  section > .wrap > :global(.silicon-section) { border-top: none; padding-top: 0; }

  .ssub { color: var(--dim); font-size: 15px; margin-bottom: 24px; }
</style>
