---
import { getLangFromUrl, useTranslations } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section class="silicon-section">
  <div class="eb">{t('silicon.eyebrow')}</div>
  <h2>
    {t('silicon.title.a')}<em>{t('silicon.title.em')}</em>{t('silicon.title.b')}
  </h2>
  <p class="lead" set:html={t('silicon.lead').replace('projetamos o circuito integrado', '<b style="color:#cdd8f2">projetamos o circuito integrado</b>')}></p>

  <div class="fabless-grid">
    <div class="fbox">
      <div class="fbox-eyebrow">{t('silicon.br.eyebrow')}</div>
      <div class="fbox-title">{t('silicon.br.title')}</div>
      <p class="fbox-body">{t('silicon.br.body')}</p>
    </div>
    <div class="fbox fbox-cn">
      <div class="fbox-eyebrow">{t('silicon.cn.eyebrow')}</div>
      <div class="fbox-title">{t('silicon.cn.title')}</div>
      <p class="fbox-body">{t('silicon.cn.body')}</p>
    </div>
  </div>

  <p class="lead lead-fabless">
    {t('silicon.fabless')}
  </p>

  <div class="split">
    <div class="points">
      <div class="pt"><span class="v">◷</span><div><b>{t('silicon.point1.label')}</b> — {t('silicon.point1.body')}</div></div>
      <div class="pt"><span class="v">▢</span><div><b>{t('silicon.point2.label')}</b> — {t('silicon.point2.body')}</div></div>
      <div class="pt"><span class="v">✂</span><div><b>{t('silicon.point3.label')}</b> — {t('silicon.point3.body')}</div></div>
      <div class="pt"><span class="v">▣</span><div><b>{t('silicon.point4.label')}</b> — {t('silicon.point4.body')}</div></div>
    </div>
    <div class="frame">
      <img src="/assets/silicon_wafer_manufacturing.png" alt="Wafer de silício sendo fabricado e cortado" />
      <div class="glow"></div>
      <div class="scan"></div>
      <div class="cap">{t('silicon.wafer.caption')}</div>
    </div>
  </div>

  <div class="flow">
    <div class="step"><div class="n">01</div><h3>{t('silicon.step1.title')}</h3><p>{t('silicon.step1.body')}</p><span class="arr">→</span></div>
    <div class="step"><div class="n">02</div><h3>{t('silicon.step2.title')}</h3><p>{t('silicon.step2.body')}</p><span class="arr">→</span></div>
    <div class="step"><div class="n">03</div><h3>{t('silicon.step3.title')}</h3><p>{t('silicon.step3.body')}</p><span class="arr">→</span></div>
    <div class="step"><div class="n">04</div><h3>{t('silicon.step4.title')}</h3><p>{t('silicon.step4.body')}</p></div>
  </div>
</section>
<style>
  .silicon-section{padding:50px 0;border-top:1px solid var(--line)}
  .eb{color:var(--cyan);font-weight:600;letter-spacing:.28em;font-size:11px;text-transform:uppercase}
  h2{font-family:'Space Grotesk',sans-serif;font-size:clamp(28px,4vw,40px);line-height:1.05;margin:10px 0 8px}
  h2 em{font-style:normal;background:linear-gradient(120deg,var(--cyan),var(--blue));-webkit-background-clip:text;background-clip:text;color:transparent}
  .lead{color:var(--dim);font-size:16px;max-width:54ch}
  .lead-fabless{margin-top:16px}

  .fabless-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:20px;max-width:820px}
  @media(max-width:760px){.fabless-grid{grid-template-columns:1fr}}
  .fbox{border:1px solid #1d2940;border-radius:12px;padding:16px;background:linear-gradient(180deg,#0f1729,#0b1120)}
  .fbox-cn{border-color:rgba(92,225,230,.35)}
  .fbox-eyebrow{color:#5ce1e6;font-size:10px;letter-spacing:.24em;text-transform:uppercase;font-weight:600}
  .fbox-title{font-family:'Space Grotesk',sans-serif;font-size:18px;margin:6px 0 4px}
  .fbox-body{color:#8b97b4;font-size:13px}

  .split{display:grid;grid-template-columns:1fr 1.15fr;gap:30px;align-items:center;margin-top:28px}
  @media(max-width:900px){.split{grid-template-columns:1fr}}
  .points{display:flex;flex-direction:column;gap:12px}
  .pt{display:flex;gap:12px;font-size:14.5px;color:#dbe4f5}
  .pt .v{color:var(--cyan);font-weight:700;flex:none}

  .frame{position:relative;border:1px solid var(--line);border-radius:18px;overflow:hidden;background:#05070d;box-shadow:0 0 50px rgba(92,225,230,.10)}
  .frame img{display:block;width:100%;height:420px;object-fit:cover}
  .frame .scan{position:absolute;inset:0;pointer-events:none;background:linear-gradient(transparent 96%,rgba(92,225,230,.06) 96%);background-size:100% 5px}
  .frame .glow{position:absolute;inset:0;pointer-events:none;background:radial-gradient(420px 240px at 70% 30%,rgba(92,225,230,.12),transparent 60%)}
  .frame .cap{position:absolute;left:16px;bottom:14px;font-size:12px;color:#cdd8f2;background:rgba(7,11,22,.6);border:1px solid var(--line);padding:6px 11px;border-radius:8px;backdrop-filter:blur(4px)}

  .flow{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:34px}
  @media(max-width:760px){.flow{grid-template-columns:1fr 1fr}}
  .step{border:1px solid var(--line);border-radius:14px;padding:18px;background:var(--panel);position:relative}
  .step .n{font-family:'Space Grotesk',sans-serif;font-size:12px;color:var(--cyan);letter-spacing:.2em}
  .step h3{font-size:16px;margin:8px 0 4px}
  .step p{color:var(--dim);font-size:13px}
  .step .arr{position:absolute;right:-11px;top:50%;transform:translateY(-50%);color:#33405a;font-size:18px}
  @media(max-width:760px){.step .arr{display:none}}
</style>
