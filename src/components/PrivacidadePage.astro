---
import Base from '../layouts/Base.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import { privacy } from '../data/privacy';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const doc = privacy[lang] ?? privacy.pt;
---
<Base title={t('meta.title.privacy')} description={t('meta.desc.privacy')}>
  <div class="wrap">
    <article class="policy">
      <h1>{doc.title}</h1>
      {doc.blocks.map((b) => (
        b.t === 'h2' ? <h2 set:html={b.html} /> :
        b.t === 'ul' ? <ul>{(b.items ?? []).map((it) => <li set:html={it} />)}</ul> :
        <p set:html={b.html} />
      ))}
    </article>
  </div>
  <style>
    .policy{max-width:820px;margin:40px auto;padding-bottom:40px}
    .policy h1{font-size:34px;margin-bottom:18px}
    .policy h2{font-size:22px;margin:26px 0 8px;color:#cdd8f2}
    .policy p{color:var(--dim);margin-bottom:10px}
    .policy ul{color:var(--dim);margin-bottom:10px;padding-left:20px}
    .policy li{margin-bottom:6px}
    .policy a{color:var(--cyan);text-decoration:underline}
  </style>
</Base>
